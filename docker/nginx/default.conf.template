server {
    listen 80;
    server_name _;

    client_max_body_size 20M;

    # Trust X-Forwarded-* headers from HAProxy
    real_ip_header X-Forwarded-For;
    ${LOAD_BALANCER_IPS}

    # Use Docker's DNS resolver for dynamic hostname resolution
    resolver 127.0.0.11 valid=30s;

    # Serve static files directly
    location /static/ {
        root /;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Serve media files directly
    location /media/ {
        root /;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Report images and their thumbnails go through Django's permission check.
    location /media/images/ {
        include /etc/nginx/snippets/proxy_django.conf;
    }

    location /media/generated_thumbnails/ {
        include /etc/nginx/snippets/proxy_django.conf;
    }

    # Django sends permitted media files here with X-Accel-Redirect. Django sets Cache-Control.
    location /protected-media/ {
        internal;
        alias /media/;
    }

    # Proxy all other requests to Django
    location / {
        include /etc/nginx/snippets/proxy_django.conf;
    }

    # Include maintenance configuration
    include /etc/nginx/conf.d/maintenance.conf;
}
